{
  "name": "metaheuristic-app",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-disable-host-check": "ng serve --disable-host-check",
    "start-dev": "ng serve --configuration development --disable-host-check --host=localhost",
    "start-standalone": "ng serve --configuration standalone --disable-host-check --host=localhost",
    "start-production-standalone": "ng serve --configuration production-standalone --disable-host-check --host=localhost",
    "ng cache clean": "ng cache clean",
    "build": "ng build",
    "build1": "ng build --delete-output-path",
    "build2": "ng build --baseHref=/aiai-app/ --prod=true",
    "build3": "ng build --prod=true",
    "build4": "ng build --aot --configuration production",
    "build4.1 ng build --aot --configuration production-no-ssl": "ng build --aot --configuration production-no-ssl",
    "build4.2 ng build --aot --configuration production-standalone": "ng build --aot --configuration production-standalone",
    "build4.3 ng build --aot --configuration standalone": "ng build --aot --configuration standalone",
    "build5": "ng build --aot",
    "build6": "set SASS_QUIET_DEPS=true && ng build --configuration development",
    "npm install -g npm@9.8.1": "npm install -g npm@9.8.1",
    "update1": "ng update @angular/core@15 @angular/cli@15",
    "update2": "ng update @angular/core @angular/cli",
    "update3": "ng update @angular/material@11",
    "update4": "npm update --all --force",
    "update4.1": "npm update --all",
    "update5": "ng update @angular/core @angular/cli --to=20",
    "npm-install-g": "npm install -g @angular/cli@latest",
    "npm-install": "npm install",
    "npm-install-force": "npm install --force",
    "ng add @angular/material": "ng add @angular/material",
    "npm-audit": "npm audit",
    "npm-audit-fix": "npm audit fix",
    "npm-audit-fix-force": "npm audit fix --force",
    "npm-install2": "npm install -g npm",
    "npm-i-package-lockg": "npm i --package-lock-only",
    "ng add @angular-eslint/schematics": "ng add @angular-eslint/schematics",
    "ng g @angular-eslint/schematics:convert-tslint-to-eslint": "ng g @angular-eslint/schematics:convert-tslint-to-eslint metaheuristic-app-e2e",
    "npm run test": "npm run test",
    "npm run test:watch": "npm run test:watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "version": "ng version",
    "temp": "npm ls glob",
    "extract-i18n": "ngx-translate-extract  -p /**/*.html /**/*.ts /**/*.pug --input ./src --output ./src/assets/i18n/EN.json ./src/assets/i18n/RU.json --clean --sort --format json --marker marker",
    "ng--migrate-only--from12.0.0 --to 13.0.0": "ng update @angular/cdk --migrate-only --from 12.0.0 --to 13.0.0",
    "sass-migrator namespace **/*.scss": "sass-migrator -n namespace **/*.scss",
    "npm install electron-builder --save-dev": "npm install electron-builder@26.0.20 --save-dev",
    "npm install -g @electron/packager@latest": "npm install -g @electron/packager@latest",
    "electron-packager": "electron-packager appdirectory metaheuristic --platform=win32 --arch=x64 --electron-version=38.2.0 --out=release-builds --icon=./src/assets/images/mh-steam-256px-256px.ico",
    "electron-packager 2": "electron-packager appdirectory metaheuristic --platform=win32 --arch=x64 --electron-version=38.2.0 --out=release-builds --overwrite --asar --prune=true --icon=./build/icon.ico",
    "npm install material-icons --save": "npm install material-icons --save",
    "npm install material-design-icons --save": "npm install material-design-icons --save",
    "ng update @angular/core@20 @angular/cli@20": "ng update @angular/core@20 @angular/cli@20",
    "ng update @angular/material@20": "ng update @angular/material@20 --force",
    "ng update @angular-eslint/schematics@20": "ng update @angular-eslint/schematics@20",
    "npm uninstall zone.js": "npm uninstall zone.js",
    "npm uninstall -g electron-packager": "npm uninstall -g electron-packager",
    "ng generate @angular/core:standalone": "ng generate @angular/core:standalone",
    "tem1": "npm uninstall karma karma-chrome-launcher karma-coverage karma-jasmine karma-jasmine-html-reporter jasmine-core @types/jasmine jasmine-spec-reporter karma-coverage-istanbul-reporter  --force",
    "npm uninstall @biesbjerg/ngx-translate-extract": "npm uninstall @biesbjerg/ngx-translate-extract --force",
    "npm install yaml": "npm install yaml",
    "ng g @angular/core:control-flow": "ng g @angular/core:control-flow",
    "npm install ngxtension": "npm install ngxtension",
    "ng add ngxtension": "ng add ngxtension",
    "ng update electron": "ng update electron@latest",
    "ng update electron-builder": "ng update electron-builder@latest",
    "ng generate ngxtension-plugin:init": "ng generate ngxtension-plugin:init",
    "ng g ngxtension:convert-signal-inputs": "ng g ngxtension:convert-signal-inputs",
    "ng g ngxtension:convert-signal-outputs": "ng g ngxtension:convert-outputs",
    "npx ng g ngxtension:convert-queries ": "npx ng g ngxtension:convert-queries ",
    "npx ng g ngxtension:convert-di-to-inject": "npx ng g ngxtension:convert-di-to-inject",
    "npm list ngxtension": "npm list ngxtension",
    "ng g --help | findstr ngxtension -A 10": "ng g --help | findstr ngxtension -A 10",
    "npm list @ngxtension/platform": "npm list @ngxtension/platform",
    "cat package.json | grep -i ngxtension": "cat package.json | grep -i ngxtension",
    "ng g --help | grep ngxtension": "ng g --help",
    "npm uninstall ngxtension": "npm uninstall ngxtension",
    "npm install @ngxtension/platform": "npm install @ngxtension/platform",
    "npm install ngxtension@4.0.0 --save-dev": "npm install ngxtension@4.0.0 --save-dev",
    "npm info ngxtension": "npm info ngxtension",
    "npm install -g ngxtension": "npm install -g ngxtension",
    "npm install ngxtension --save-dev": "npm install ngxtension --save-dev",
    "npm install @ngxtension/schematics --save-dev": "npm install @ngxtension/schematics --save-dev",
    "npm install typescript@latest": "npm install typescript@latest",
    "npm install rxjs@latest": "npm install rxjs@latest",
    "npm install --save-dev vitest @vitest/ui @analogjs/vite-plugin-angular jsdom": "npm install --save-dev vitest @vitest/ui @analogjs/vite-plugin-angular jsdom",
    "npm install ngx-translate/core": "npm install @ngx-translate/core@^17.0.0",
    "npm install ngx-translate/http-loader --save-dev": "npm install @ngx-translate/http-loader@17.0.0"
  },
  "engines": {
    "node": ">=18.18.2",
    "npm": ">=9.8.1"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.2",
    "@angular/cdk": "^20.2.7",
    "@angular/common": "^20.3.2",
    "@angular/compiler": "^20.3.2",
    "@angular/core": "^20.3.2",
    "@angular/forms": "^20.3.2",
    "@angular/material": "^20.2.7",
    "@angular/platform-browser": "^20.3.2",
    "@angular/platform-browser-dynamic": "^20.3.2",
    "@angular/router": "^20.3.2",
    "@biesbjerg/ngx-translate-extract-marker": "1.0.0",
    "@material-design-icons/font": "^0.14.13",
    "@material-design-icons/svg": "^0.14.13",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "core-js": "3.45.1",
    "file-saver": "2.0.5",
    "jszip": "3.10.1",
    "material-icons": "^1.13.12",
    "ngx-toastr": "^19.1.0",
    "normalize.css": "8.0.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.3",
    "@angular-eslint/builder": "^20.3.0",
    "@angular-eslint/eslint-plugin": "^20.3.0",
    "@angular-eslint/eslint-plugin-template": "^20.3.0",
    "@angular-eslint/schematics": "^20.3.0",
    "@angular-eslint/template-parser": "^20.3.0",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.2",
    "@angular/language-service": "^20.3.2",
    "@types/node": "^18.18.6",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vendure/ngx-translate-extract": "^10.1.0",
    "@vitest/ui": "^2.1.9",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.20",
    "eslint": "^9.35.0",
    "jsdom": "^25.0.1",
    "ngxtension": "^4.0.0",
    "ts-node": "10.9.2",
    "vite": "^6.3.6",
    "vitest": "^2.1.9"
  }
}
