{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@services/*": [
        "./src/app/services/*"
      ],
      "@src/*": [
        "./src/*"
      ]
    },
    "outDir": "./dist/out-tsc",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2023",
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "ES2023",
      "dom"
    ]
  }
}
